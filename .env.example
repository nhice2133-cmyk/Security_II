# ==============================================================================
# CyberAuth System — Environment Configuration
# ==============================================================================

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=auth_system

# Email (SMTP) Configuration — Gmail Google App Password
#
# INSTRUCTIONS FOR GMAIL GOOGLE APP PASSWORD:
# 1. Sign in to your Google Account at https://myaccount.google.com/
# 2. Go to "Security" on the left menu.
# 3. Ensure "2-Step Verification" is turned ON.
# 4. Search for "App passwords" in the search box, or go directly to:
#    https://myaccount.google.com/apppasswords
# 5. Type an App name (e.g. "CyberAuth") and click "Create".
# 6. Google will generate a 16-character password (e.g., abcd efgh ijkl mnop).
# 7. Copy that 16-character code and paste it below for SMTP_PASSWORD.
#    (Note: Spaces are automatically stripped by the system).
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_character_app_password
FROM_EMAIL=your_gmail_address@gmail.com
FROM_NAME=CyberAuth System
